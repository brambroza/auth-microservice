# Copy to .env and fill in. Never commit the real file.

# Public URL of this service. It becomes the "iss" claim, so every system
# that verifies tokens must be configured with exactly this value.
AUTH_ISSUER=http://localhost:8080
AUTH_AUDIENCE=goalong

AUTH_DATABASE_URL=postgres://auth:auth@localhost:5432/auth?sslmode=disable

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# It encrypts signing keys and TOTP secrets in the database. Back it up:
# without it those rows cannot be read.
# AUTH_MASTER_KEY=

AUTH_HTTP_ADDR=:8080
AUTH_ACCESS_TTL=10m
AUTH_REFRESH_TTL=720h
AUTH_SESSION_MAX_TTL=2160h
AUTH_MFA_CHALLENGE_TTL=5m
AUTH_MAX_FAILED_LOGINS=10
AUTH_LOCK_DURATION=15m
AUTH_LOGIN_RATE_PER_MIN=60
AUTH_DB_MAX_CONNS=10
AUTH_AUTO_MIGRATE=true

# true only when the service is reachable solely through your own gateway,
# which must append the client address to X-Forwarded-For.
AUTH_TRUST_PROXY=false

# Browser origins allowed to call the API, comma separated.
AUTH_CORS_ORIGINS=http://localhost:3000
